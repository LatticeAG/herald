{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/Capabilities.schema.json",
  "title": "Herald Capabilities",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      },
      "maxItems": 64,
      "uniqueItems": true,
      "description": "sorted unique"
    },
    "v": {
      "const": 1
    }
  },
  "required": [
    "capabilities",
    "v"
  ],
  "additionalProperties": false
}
