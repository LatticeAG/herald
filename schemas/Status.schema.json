{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/Status.schema.json",
  "title": "Herald Status",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "bits": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{21846}$",
          "description": "base64url of 16384 bytes"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "log_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "pattern": "^hr_[A-Za-z0-9_-]{21}$"
        },
        "root_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "slots": {
          "const": 131072
        },
        "state": {
          "enum": [
            "active",
            "frozen"
          ]
        },
        "v": {
          "const": 1
        }
      },
      "required": [
        "bits",
        "expires_at",
        "issued_at",
        "log_hash",
        "root",
        "root_epoch",
        "seq",
        "slots",
        "state",
        "v"
      ],
      "additionalProperties": false
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^hk_[A-Za-z0-9_-]{21}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "description": "base64url of 64 bytes"
          }
        },
        "required": [
          "kid",
          "signature"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16,
      "description": "strictly ascending unique by kid"
    }
  },
  "required": [
    "body",
    "proofs"
  ],
  "additionalProperties": false
}
