{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/DoctorReply.schema.json",
  "title": "Herald DoctorReply",
  "type": "object",
  "properties": {
    "checks": {
      "type": "object",
      "properties": {
        "cache": {
          "enum": [
            "usable",
            "stale",
            "forked"
          ]
        },
        "capacity": {
          "enum": [
            "ok",
            "warning",
            "full"
          ]
        },
        "clock": {
          "enum": [
            "ok",
            "unsafe"
          ]
        },
        "root": {
          "enum": [
            "trusted",
            "untrusted"
          ]
        },
        "storage": {
          "enum": [
            "ok",
            "unavailable"
          ]
        }
      },
      "required": [
        "cache",
        "capacity",
        "clock",
        "root",
        "storage"
      ],
      "additionalProperties": false
    },
    "ready": {
      "type": "boolean"
    },
    "v": {
      "const": 1
    }
  },
  "required": [
    "checks",
    "ready",
    "v"
  ],
  "additionalProperties": false
}
