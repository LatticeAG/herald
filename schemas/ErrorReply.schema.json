{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/ErrorReply.schema.json",
  "title": "Herald ErrorReply",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]{2,40}$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "additionalProperties": false
    },
    "v": {
      "const": 1
    }
  },
  "required": [
    "error",
    "v"
  ],
  "additionalProperties": false
}
