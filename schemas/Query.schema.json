{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/Query.schema.json",
  "title": "Herald Query",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^hk_[A-Za-z0-9_-]{21}$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "query": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "card_id": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^hc_[A-Za-z0-9_-]{21}$"
                    }
                  ]
                },
                "did": {
                  "type": "string",
                  "pattern": "^did:herald:hr_[A-Za-z0-9_-]{21}:ha_[A-Za-z0-9_-]{21}$",
                  "maxLength": 64
                },
                "kind": {
                  "const": "resolve"
                }
              },
              "required": [
                "card_id",
                "did",
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "receipt"
                },
                "op_id": {
                  "type": "string",
                  "pattern": "^ho_[A-Za-z0-9_-]{21}$"
                }
              },
              "required": [
                "kind",
                "op_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "after_revision": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                "did": {
                  "type": "string",
                  "pattern": "^did:herald:hr_[A-Za-z0-9_-]{21}:ha_[A-Za-z0-9_-]{21}$",
                  "maxLength": 64
                },
                "kind": {
                  "const": "export"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "after_revision",
                "did",
                "kind",
                "limit"
              ],
              "additionalProperties": false
            }
          ],
          "discriminator": {
            "propertyName": "kind"
          }
        },
        "query_id": {
          "type": "string",
          "pattern": "^hq_[A-Za-z0-9_-]{21}$"
        },
        "root": {
          "type": "string",
          "pattern": "^hr_[A-Za-z0-9_-]{21}$"
        },
        "v": {
          "const": 1
        }
      },
      "required": [
        "actor",
        "expires_at",
        "issued_at",
        "query",
        "query_id",
        "root",
        "v"
      ],
      "additionalProperties": false
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^hk_[A-Za-z0-9_-]{21}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "description": "base64url of 64 bytes"
          }
        },
        "required": [
          "kid",
          "signature"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16,
      "description": "strictly ascending unique by kid"
    }
  },
  "required": [
    "body",
    "proofs"
  ],
  "additionalProperties": false
}
