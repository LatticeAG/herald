{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/MigrationDescriptor.schema.json",
  "title": "Herald MigrationDescriptor",
  "type": "object",
  "properties": {
    "expected_events": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "from": {
      "type": "integer",
      "minimum": 0
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "to": {
      "type": "integer",
      "minimum": 0
    },
    "v": {
      "const": 1
    }
  },
  "required": [
    "expected_events",
    "from",
    "source_head",
    "to",
    "v"
  ],
  "additionalProperties": false
}
