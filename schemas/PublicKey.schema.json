{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/herald/PublicKey.schema.json",
  "title": "Herald PublicKey",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hk_[A-Za-z0-9_-]{21}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url of 32 bytes"
    }
  },
  "required": [
    "id",
    "public_key"
  ],
  "additionalProperties": false
}
